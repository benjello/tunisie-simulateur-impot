# ─────────────────────────────────────────────────────────────────────────
# Modèle de configuration locale. Copie ce fichier en `.env` (gitignoré) et
# remplis les valeurs. Sert à propager les secrets shinyapps.io vers les repos
# GitHub via scripts/set_shinyapps_secrets.sh.
#
#   cp .env.example .env && chmod 600 .env   # puis éditer .env
# ─────────────────────────────────────────────────────────────────────────
# Où trouver les valeurs : https://www.shinyapps.io
#   → connecte-toi → menu profil → Account → Tokens
#   → sur un token : bouton "Show secret" (le token ET le secret s'affichent)
#
# Utilisation une fois rempli :
#   source .env && scripts/set_shinyapps_secrets.sh benjello/tunisie-simulateur-impot
# ─────────────────────────────────────────────────────────────────────────

# Nom du compte shinyapps.io.
SHINYAPPS_ACCOUNT=benjello

# Token (chaîne hexadécimale, ~32 caractères).
SHINYAPPS_TOKEN=

# Secret associé au token (bouton "Show secret").
SHINYAPPS_SECRET=
